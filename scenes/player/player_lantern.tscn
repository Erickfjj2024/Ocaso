[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scenes/player/player_lantern.gd" id="1_script"]

; Gradiente radial: branco opaco no centro → transparente na borda
[sub_resource type="Gradient" id="Gradient_1"]
offsets = PackedFloat32Array(0, 1)
colors = PackedColorArray(1, 1, 1, 1, 1, 1, 1, 0)

; Textura 2D gerada pelo gradiente radial — usada como "blob" de luz
[sub_resource type="GradientTexture2D" id="GradTexture_1"]
gradient = SubResource("Gradient_1")
width = 128
height = 128
fill = 1

; Área de detecção circular (quem está dentro da luz)
[sub_resource type="CircleShape2D" id="Circle_1"]
radius = 64.0

; ── Raiz da sub-cena ──────────────────────────────────────────
[node name="PlayerLantern" type="Node2D"]
script = ExtResource("1_script")

; Luz verde da lanterna — desligada por padrão (LanternManager controla)
[node name="PointLight2D" type="PointLight2D" parent="."]
color = Color(0.4, 1.0, 0.5, 1.0)
energy = 1.2
texture = SubResource("GradTexture_1")
texture_scale = 2.0
shadow_enabled = true
enabled = false

; Area2D "LanternCone": inimigos checam overlap aqui para saber se estão na luz
; Layer 4 = "lantern_cone" (define em Project > Layer Names > 2D Physics)
[node name="LanternCone" type="Area2D" parent="."]
collision_layer = 4
collision_mask = 0
monitoring = false
monitorable = true

[node name="CollisionShape2D" type="CollisionShape2D" parent="LanternCone"]
shape = SubResource("Circle_1")
