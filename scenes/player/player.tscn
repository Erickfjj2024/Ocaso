[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scenes/player/player.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://scenes/player/player_lantern.tscn" id="2_lantern"]

; Cápsula de colisão do corpo do player
[sub_resource type="CapsuleShape2D" id="Capsule_1"]
radius = 5.0
height = 10.0

; ── Raiz do Player ────────────────────────────────────────────
; Layer 1 = "player" | Mask 2 = "walls"
[node name="Player" type="CharacterBody2D"]
collision_layer = 1
collision_mask = 2
script = ExtResource("1_script")

; Hitbox do corpo (receber colisão com paredes)
[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
position = Vector2(0, 2)
shape = SubResource("Capsule_1")

; Sprite placeholder: retângulo vermelho 10×20 px
; Substituir por Sprite2D + spritesheet quando o art estiver pronto
[node name="BodyPlaceholder" type="Polygon2D" parent="."]
polygon = PackedVector2Array(-5, -10, 5, -10, 5, 10, -5, 10)
color = Color(0.85, 0.25, 0.25, 1.0)

; AnimationPlayer — sem animações por ora (placeholder)
[node name="AnimationPlayer" type="AnimationPlayer" parent="."]

; Câmera que segue o player — zoom 1×1 (viewport já é 320×180 escalado)
[node name="Camera2D" type="Camera2D" parent="."]
position_smoothing_enabled = true
position_smoothing_speed = 8.0

; Sub-cena da lanterna instanciada como filha do player
[node name="PlayerLantern" parent="." instance=ExtResource("2_lantern")]
