; ── HUD (CanvasLayer layer=10) ────────────────────────────────
; CanvasLayer isola a HUD da CanvasModulate do mundo —
; os elementos da UI sempre aparecem com brilho total.
[node name="HUD" type="CanvasLayer"]
layer = 10
script = ExtResource("1_script")

