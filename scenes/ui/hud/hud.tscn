; ── HUD Gaslighter ───────────────────────────────────────────
; Gerencia as 5 manipulações psicológicas quando Sanidade < 15.
; PhantomArrow: Label "▶" posicionada dinamicamente na borda da tela.

[node name="HUDGaslighter" type="Node" parent="."]
script = ExtResource("2_gaslighter")

[node name="PhantomArrow" type="Label" parent="HUDGaslighter"]
visible = false
offset_left = 0.0
offset_top = 0.0
offset_right = 16.0
offset_bottom = 16.0
text = "▶"
modulate = Color(1.0, 0.1, 0.1, 1.0)
theme_override_font_sizes/font_size = 12

; ── Flash de dano (cobre a tela inteira por instante) ─────────
; Cor vermelha com alpha=0; o script anima o alpha via modulate
[node name="DamageFlash" type="ColorRect" parent="."]
offset_left = 0.0
offset_top = 0.0
offset_right = 320.0
offset_bottom = 180.0
color = Color(0.9, 0.05, 0.05, 0.0)
mouse_filter = 2
